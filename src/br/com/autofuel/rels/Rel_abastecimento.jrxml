	<queryString language="SQL">
		<![CDATA[SELECT 
    a.dat_abast,
    a.placa_abast,
    b.tipo_comb_bom,
    a.litros_abast,
    a.val_litro_abast,
    a.val_total_abast,
    f.nome_fun
FROM abastecimento a, bomba b, funcionario f
WHERE a.id_bom = b.id_bom
AND a.id_fun = f.id_fun
ORDER BY a.dat_abast]]>
	</queryString>
	<field name="dat_abast" class="java.sql.Date"/>
	<field name="placa_abast" class="java.lang.String"/>
	<field name="tipo_comb_bom" class="java.lang.String"/>
